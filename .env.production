# ─────────────────────────────────────────────────────────────
# DevTrack AI — Production Environment Configuration Template
# ─────────────────────────────────────────────────────────────

# Application Settings
APP_NAME="DevTrack AI Engine"
APP_ENV="production"
DEBUG="false"
API_V1_STR="/api/v1"

# Security (CRITICAL: Replace with strong random 64-char strings)
SECRET_KEY="generate-secure-64-character-random-key-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# File Signing Secret (CRITICAL: Replace with secure random secret)
FILE_SIGNED_URL_SECRET="generate-secure-random-secret-for-hmac-file-urls"

# Database (PostgreSQL)
POSTGRES_SERVER="db"
POSTGRES_PORT="5432"
POSTGRES_USER="devtrack_prod"
POSTGRES_PASSWORD="generate-strong-db-password"
POSTGRES_DB="devtrack_production"
DATABASE_URL="postgresql+asyncpg://devtrack_prod:generate-strong-db-password@db:5432/devtrack_production"

# Redis Cache & PubSub
REDIS_HOST="redis"
REDIS_PORT="6379"

# Storage Settings (AWS S3)
USE_S3="true"
S3_BUCKET="devtrack-production-files"
S3_REGION="us-east-1"
AWS_ACCESS_KEY_ID="YOUR_PRODUCTION_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_PRODUCTION_AWS_SECRET_ACCESS_KEY"
S3_SIGNED_URL_EXPIRY=3600
MAX_FILE_SIZE_MB=50

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["https://app.devtrack.ai"]

# Observability
PROMETHEUS_ENABLED="true"

# OpenAI API Key (Optional)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
