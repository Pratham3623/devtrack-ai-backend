# ==============================================================================
# DevTrack AI — Production Environment Configuration Template
# COPY THIS FILE TO '.env.production' ON YOUR PRODUCTION SERVER AND SET REAL VALUES
# NEVER COMMIT ACTUAL SECRETS TO SOURCE CONTROL
# ==============================================================================

# ── Core Application Settings ──────────────────────────────────────────────────
APP_NAME="DevTrack AI Engine"
APP_ENV=production
DEBUG=false
API_V1_STR=/api/v1

# 32+ byte cryptographically secure random string. Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_MIN_32_BYTES_LONG

# ── Security & Authentication ─────────────────────────────────────────────────
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=2

# CORS — Whitelist your exact frontend production domains (JSON Array String)
BACKEND_CORS_ORIGINS=["https://app.devtrack.ai","https://devtrack-ai.vercel.app"]

# ── PostgreSQL Database Configuration ─────────────────────────────────────────
USE_SQLITE=false
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=devtrack_admin
POSTGRES_PASSWORD=CHANGE_THIS_PRODUCTION_DATABASE_PASSWORD_SECURE
POSTGRES_DB=devtrack_production_db
DATABASE_POOL_SIZE=30
DATABASE_MAX_OVERFLOW=15

# Optional Direct Connection URI override (e.g. for Managed Databases like Railway/Render/DigitalOcean)
# DATABASE_URL=postgresql+asyncpg://devtrack_admin:password@production-db-host:5432/devtrack_production_db

# ── Redis Cache & Pub/Sub ─────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD_SECURE
REDIS_DB=0

# Optional Direct Redis URI
# REDIS_URL=redis://:password@production-redis-host:6379/0

# ── OAuth Provider Credentials (Optional) ──────────────────────────────────────
GITHUB_CLIENT_ID=your_github_production_client_id
GITHUB_CLIENT_SECRET=your_github_production_client_secret
GOOGLE_CLIENT_ID=your_google_production_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_production_client_secret

# ── File Uploads & Storage ───────────────────────────────────────────────────
MAX_UPLOAD_SIZE_BYTES=52428800
UPLOAD_DIR=/app/uploads

# ── Production Monitoring & Telemetry ─────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_THIS_GRAFANA_ADMIN_PASSWORD
PROMETHEUS_METRICS_ENABLED=true
